image:
    tag: {{ env "APP_VERSION" | default "latest" }}
    pullPolicy: Always

replicaCount: 1

imagePullSecrets:
    - name: registry-credentials

service:
    enabled: true
    ports:
        - name: grpc
          port: 8090
          targetPort: 8090
        - name: http
          port: 8080
          targetPort: 8080

deployment:
    podAnnotations:
        prometheus.io/scrape: "true"
        prometheus.io/path: /metrics
        prometheus.io/port: "8081"

# Хэлсчеки: fiber-healthcheck из pkg/http/fiber отдаёт /livez и /readyz на HTTP-порту
livenessProbe:
    enabled: true
    httpGet:
        path: /livez
        port: 8081
    initialDelaySeconds: 5
    periodSeconds: 10
    timeoutSeconds: 2
    failureThreshold: 3

readinessProbe:
    enabled: true
    httpGet:
        path: /readyz
        port: 8081
    initialDelaySeconds: 5
    periodSeconds: 5
    timeoutSeconds: 2
    failureThreshold: 3

# БД coin и пользователь coin создаются джобой postgres-init (pgsql_users в helmfile)
envs:
    PGSQL_USER: "coin"
    PGSQL_DATABASE: "coin"

# Секреты — из Vault через VSO (релиз vault-secrets, vault/README.md):
# coin-server-vault — secret/coin/coin-server/<окружение>, ключи = имена переменных;
# coin-server-db — PGSQL_PASSWORD из secret/infra/postgres/<окружение>/coin
extraEnvFrom:
    - secretRef:
          name: coin-server-vault
    - secretRef:
          name: coin-server-db
