image:
    repository: ghcr.io/finfix/go-server

ingresses:
    - enabled: true
      className: nginx
      annotations:
          cert-manager.io/cluster-issuer: letsencrypt
          nginx.ingress.kubernetes.io/backend-protocol: GRPC
      hosts:
          - host: grpc.bonavii.com
            paths:
                - path: /
                  pathType: Prefix
      tls:
          - hosts:
                - grpc.bonavii.com
            secretName: coin-server-grpc-tls
    # MCP: обычный HTTP на порт 8092, без gRPC-аннотации
    - name: mcp
      enabled: true
      className: nginx
      annotations:
          cert-manager.io/cluster-issuer: letsencrypt
      hosts:
          - host: mcp.coin.bonavii.com
            paths:
                - path: /
                  pathType: Prefix
                  # Порт задается у пути: чарт читает servicePort из path, а не из ingress
                  servicePort: 8092
      tls:
          - hosts:
                - mcp.coin.bonavii.com
            secretName: coin-server-mcp-tls

envs:
    PGSQL_HOST: "postgres-postgresql.postgres-prod.svc.cluster.local:5432"
    # Трейсы по OTLP HTTP в Alloy кластера → Tempo
    OTLP_IS_ENABLED: "true"
    OTLP_HTTP_ENDPOINT: "{{ .Values.endpoints.alloy.otlpHttp }}"
    OTLP_INSECURE: "true"
    SERVICE_NAME: "coin"
    ENVIRONMENT: "prod"
    TG_BOT_ENABLED: "true"
    STACK_TRACE_ENABLED: "true"
    LOG_LEVEL: "debug"
    LOG_FORMAT: "json"
    LISTEN_HTTP: "0.0.0.0:8080"
    LISTEN_SERVICE_HTTP: "0.0.0.0:8081"
    LISTEN_GRPC: "0.0.0.0:8090"
    LISTEN_MCP: "0.0.0.0:8092"
    # Публичный URL MCP: issuer Authorization Server OAuth и resource для токенов
    MCP_PUBLIC_URL: "https://mcp.coin.bonavii.com"
    AUTH_REFRESH_TOKEN_TTL: "720h"
    AUTH_ACCESS_TOKEN_TTL: "30m"
    AUTH_REFRESH_TOKEN_GRACE_PERIOD: "5m"
    NOTIFICATIONS_ENABLED: "false"
    NOTIFICATIONS_APNS_KEY_FILE_PATH: ""
