image:
    repository: ghcr.io/finfix/go-server

ingresses:
    - enabled: true
      className: nginx
      annotations:
          cert-manager.io/cluster-issuer: letsencrypt
          nginx.ingress.kubernetes.io/backend-protocol: GRPC
      hosts:
          - host: grpc.bonavii.com
            paths:
                - path: /
                  pathType: Prefix
      tls:
          - hosts:
                - grpc.bonavii.com
            secretName: coin-server-grpc-tls

envs:
    PGSQL_HOST: "postgres-postgresql.postgres-prod.svc.cluster.local:5432"
    OTLP_IS_ENABLED: "false"
    OTLP_HTTP_ENDPOINT: ""
    OTLP_INSECURE: ""
    SERVICE_NAME: "coin"
    ENVIRONMENT: "prod"
    TG_BOT_ENABLED: "true"
    STACK_TRACE_ENABLED: "true"
    LOG_LEVEL: "debug"
    LOG_FORMAT: "json"
    LISTEN_HTTP: "0.0.0.0:8080"
    LISTEN_SERVICE_HTTP: "0.0.0.0:8081"
    LISTEN_GRPC: "0.0.0.0:8090"
    AUTH_REFRESH_TOKEN_TTL: "720h"
    AUTH_ACCESS_TOKEN_TTL: "720h"
    NOTIFICATIONS_ENABLED: "false"
    NOTIFICATIONS_APNS_KEY_FILE_PATH: ""
