image:
    repository: ghcr.io/finfix/go-server-dev

host: "rest.dev.bonavii.com"
grpc_host: "grpc.dev.bonavii.com"

envs:
    PGSQL_HOST: "postgres-postgresql.postgres-dev.svc.cluster.local:5432"
    OTLP_IS_ENABLED: "false"
    OTLP_HTTP_ENDPOINT: ""
    OTLP_INSECURE: ""
    SERVICE_NAME: "coin"
    ENVIRONMENT: "dev"
    TG_BOT_ENABLED: "false"
    STACK_TRACE_ENABLED: "true"
    LOG_LEVEL: "debug"
    LOG_FORMAT: "json"
    LISTEN_HTTP: "0.0.0.0:8080"
    LISTEN_GRPC: "0.0.0.0:8090"
    AUTH_REFRESH_TOKEN_TTL: "720h"
    AUTH_ACCESS_TOKEN_TTL: "30m"
    NOTIFICATIONS_ENABLED: "false"
    NOTIFICATIONS_APNS_KEY_FILE_PATH: ""
