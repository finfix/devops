# Только сервер, без инжектора sidecar'ов — секреты читает CI по JWT
injector:
  enabled: false

server:
  # Один экземпляр с встроенным хранилищем raft на local-path PVC
  standalone:
    enabled: false
  ha:
    enabled: true
    replicas: 1
    raft:
      enabled: true
      config: |
        ui = true
        listener "tcp" {
          tls_disable = 1
          address = "[::]:8200"
          cluster_address = "[::]:8201"
        }
        storage "raft" {
          path = "/vault/data"
        }
        service_registration "kubernetes" {}

  dataStorage:
    size: 2Gi

  ingress:
    enabled: true
    ingressClassName: nginx
    annotations:
      # Автоматический выпуск TLS сертификата через cert-manager
      cert-manager.io/cluster-issuer: letsencrypt
    hosts:
      - host: vault.bonavii.com
    tls:
      - secretName: vault-tls
        hosts:
          - vault.bonavii.com

ui:
  enabled: true
