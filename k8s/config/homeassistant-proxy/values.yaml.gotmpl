# Проброс home.bonavii.com через coin-1 в WG-туннель на rpi. TLS здесь не терминируется:
# coin-1 передаёт TCP как есть и не видит трафик. Настоящий сертификат и таймауты
# websocket живут на ingress rpi. Требует enable-ssl-passthrough у ingress-nginx.
resources:

  # Service без селектора: только "виртуальный" фронт для ingress,
  # реальные адреса приходят из EndpointSlice ниже.
  - apiVersion: v1
    kind: Service
    metadata:
      name: homeassistant-rpi
      namespace: homeassistant
    spec:
      type: ClusterIP
      ports:
        - name: https
          port: 443
          targetPort: 443
          protocol: TCP
        - name: http
          port: 80
          targetPort: 80
          protocol: TCP

  # Ручной EndpointSlice: указывает Service на WG-адрес rpi.
  - apiVersion: discovery.k8s.io/v1
    kind: EndpointSlice
    metadata:
      name: homeassistant-rpi
      namespace: homeassistant
      labels:
        # связывает slice с Service выше — имя обязано совпадать
        kubernetes.io/service-name: homeassistant-rpi
    addressType: IPv4
    ports:
      - name: https          # имя обязано совпадать с портом Service
        port: 443
        protocol: TCP
      - name: http
        port: 80
        protocol: TCP
    endpoints:
      - addresses:
          - 10.10.10.2        # WG-адрес rpi (клиент туннеля)
        conditions:
          ready: true

  # 443: TCP без расшифровки
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: homeassistant
      namespace: homeassistant
      annotations:
        nginx.ingress.kubernetes.io/ssl-passthrough: "true"
    spec:
      ingressClassName: nginx
      rules:
        - host: home.bonavii.com
          http:
            paths:
              - path: /
                pathType: Prefix
                backend:
                  service:
                    name: homeassistant-rpi
                    port:
                      number: 443

  # 80: только проверка HTTP-01, которой Let's Encrypt подтверждает домен для сертификата на rpi
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: homeassistant-acme
      namespace: homeassistant
      annotations:
        nginx.ingress.kubernetes.io/ssl-redirect: "false"
    spec:
      ingressClassName: nginx
      rules:
        - host: home.bonavii.com
          http:
            paths:
              - path: /.well-known/acme-challenge/
                pathType: Prefix
                backend:
                  service:
                    name: homeassistant-rpi
                    port:
                      number: 80
