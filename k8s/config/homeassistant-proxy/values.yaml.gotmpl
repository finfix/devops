# Проксирование home.bonavii.com через ingress coin-1 в WG-туннель на rpi.
# TLS терминируется здесь настоящим сертом home.bonavii.com, дальше идёт
# новый HTTPS-запрос на 10.10.10.2:443 (ingress rpi). Host форвардится как есть —
# rpi-ingress сам матчит home.bonavii.com (хост добавлен в его конфиг), поэтому
# переписывать Host не нужно и сниппеты не требуются.
resources:

  # Service без селектора: только "виртуальный" фронт для ingress,
  # реальные адреса приходят из EndpointSlice ниже.
  - apiVersion: v1
    kind: Service
    metadata:
      name: homeassistant-rpi
      namespace: homeassistant
    spec:
      type: ClusterIP
      ports:
        - name: https
          port: 443
          targetPort: 443
          protocol: TCP

  # Ручной EndpointSlice: указывает Service на WG-адрес rpi.
  - apiVersion: discovery.k8s.io/v1
    kind: EndpointSlice
    metadata:
      name: homeassistant-rpi
      namespace: homeassistant
      labels:
        # связывает slice с Service выше — имя обязано совпадать
        kubernetes.io/service-name: homeassistant-rpi
    addressType: IPv4
    ports:
      - name: https          # имя обязано совпадать с портом Service
        port: 443
        protocol: TCP
    endpoints:
      - addresses:
          - 10.10.10.2        # WG-адрес rpi (клиент туннеля)
        conditions:
          ready: true

  # Ingress: терминирует внешний TLS, ре-шифрует в туннель, форвардит Host как есть.
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: homeassistant
      namespace: homeassistant
      annotations:
        # ↓ ЗАМЕНИ на реальный ACME cluster-issuer на coin-1
        cert-manager.io/cluster-issuer: letsencrypt

        # бэкенд говорит HTTPS
        nginx.ingress.kubernetes.io/backend-protocol: "HTTPS"

        # серт на rpi селфсайн — проверять его нечем и незачем
        nginx.ingress.kubernetes.io/proxy-ssl-verify: "off"
        # шлём SNI = home.bonavii.com, по нему rpi-ingress подберёт server-блок.
        # Host форвардится как есть, переписывать не нужно.
        nginx.ingress.kubernetes.io/proxy-ssl-server-name: "on"
        nginx.ingress.kubernetes.io/proxy-ssl-name: "home.bonavii.com"

        # HA живёт на websocket'ах (lovelace, live-логи) — поднимаем таймауты
        nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
        nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
    spec:
      ingressClassName: nginx
      tls:
        - hosts: [home.bonavii.com]
          secretName: home-bonavii-tls     # cert-manager создаст сам
      rules:
        - host: home.bonavii.com
          http:
            paths:
              - path: /
                pathType: Prefix
                backend:
                  service:
                    name: homeassistant-rpi
                    port:
                      number: 443
