image:
    repository: ghcr.io/jedi-tasks/server-dev

ingresses:
    - enabled: true
      className: nginx
      annotations:
          cert-manager.io/cluster-issuer: letsencrypt
          nginx.ingress.kubernetes.io/backend-protocol: GRPC
      hosts:
          - host: tasks.dev.bonavii.com
            paths:
                - path: /
                  pathType: Prefix
      tls:
          - hosts:
                - tasks.dev.bonavii.com
            secretName: tasks-server-dev-tls

envs:
    PGSQL_HOST: "postgres-postgresql.postgres-dev.svc.cluster.local:5432"
    SERVICE_NAME: "tasks_server"
    ENVIRONMENT: "dev"
    LISTEN_HTTP: "0.0.0.0:8080"
    LISTEN_SERVICE_HTTP: "0.0.0.0:8081"
    LISTEN_GRPC: "0.0.0.0:8090"
    AUTH_REFRESH_TOKEN_TTL: "720h"
    AUTH_ACCESS_TOKEN_TTL: "30m"
    # Регистрация открывается вручную на время заведения пользователя
    AUTH_SIGN_UP_ENABLED: "false"
