image:
    tag: {{ env "APP_VERSION" | default "latest" }}
    pullPolicy: Always

replicaCount: 1

imagePullSecrets:
    - name: registry-credentials

service:
    enabled: true
    ports:
        - name: grpc
          port: 8090
          targetPort: 8090

deployment:
    podAnnotations:
        prometheus.io/scrape: "true"
        prometheus.io/path: /metrics
        prometheus.io/port: "8081"

# Хэлсчеки: fiber-healthcheck отдаёт /livez и /readyz на служебном HTTP-порту
livenessProbe:
    enabled: true
    httpGet:
        path: /livez
        port: 8081
    initialDelaySeconds: 5
    periodSeconds: 10
    timeoutSeconds: 2
    failureThreshold: 3

readinessProbe:
    enabled: true
    httpGet:
        path: /readyz
        port: 8081
    initialDelaySeconds: 5
    periodSeconds: 5
    timeoutSeconds: 2
    failureThreshold: 3

# БД tasks и пользователь tasks создаются джобой postgres-init (pgsql_users в helmfile)
envs:
    PGSQL_USER: "tasks"
    PGSQL_DATABASE: "tasks"
    LOG_LEVEL: info
    LOG_FORMAT: json

# Секреты — из Vault через VSO (релиз vault-secrets, vault/README.md):
# tasks-server-vault — secret/jedi-tasks/tasks-server/<окружение>, ключи = имена переменных
# (AUTH_TOKEN_SIGNING_KEY, SHA_SALT; начальный пользователь — AUTH_INITIAL_USER_NAME/EMAIL/PASSWORD:
# сервер создаёт его при запуске, если email ещё не занят; нет ключей — не создаёт);
# tasks-server-db — PGSQL_PASSWORD из secret/infra/postgres/<окружение>/tasks
extraEnvFrom:
    - secretRef:
          name: tasks-server-vault
    - secretRef:
          name: tasks-server-db
