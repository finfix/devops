image:
    repository: ghcr.io/jedi-tasks/server

ingresses:
    - enabled: true
      className: nginx
      annotations:
          cert-manager.io/cluster-issuer: letsencrypt
          nginx.ingress.kubernetes.io/backend-protocol: GRPC
      hosts:
          - host: tasks.bonavii.com
            paths:
                - path: /
                  pathType: Prefix
      tls:
          - hosts:
                - tasks.bonavii.com
            secretName: tasks-server-tls
    # MCP: обычный HTTP на порт 8092, без gRPC-аннотации
    - name: mcp
      enabled: true
      className: nginx
      annotations:
          cert-manager.io/cluster-issuer: letsencrypt
      hosts:
          - host: mcp.tasks.bonavii.com
            paths:
                - path: /
                  pathType: Prefix
                  # Порт задается у пути: чарт читает servicePort из path, а не из ingress
                  servicePort: 8092
      tls:
          - hosts:
                - mcp.tasks.bonavii.com
            secretName: tasks-server-mcp-tls

envs:
    PGSQL_HOST: "postgres-postgresql.postgres-prod.svc.cluster.local:5432"
    SERVICE_NAME: "tasks_server"
    ENVIRONMENT: "prod"
