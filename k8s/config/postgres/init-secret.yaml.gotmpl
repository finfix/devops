# Создаёт пользователей БД и одноимённые БД из pgsql_users (environments в helmfile.yaml).
# Пароли — Secret postgres-user-<пользователь> (ключ password) от VSO из Vault
# secret/infra/postgres/<окружение>/<пользователь>, суперпользователь — Secret postgres-auth.
# Существующие пользователи и БД не меняются (пароль не обновляется)
{{- $env := .Environment.Name }}
resources:
  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: postgres-init-job
      namespace: postgres-{{ $env }}
      annotations:
        helm.sh/hook: post-install,post-upgrade
        helm.sh/hook-delete-policy: before-hook-creation
    spec:
      template:
        spec:
          restartPolicy: OnFailure
          containers:
            - name: init
              image: postgres:16
              env:
                - name: PGHOST
                  value: postgres-postgresql.postgres-{{ $env }}.svc.cluster.local
                - name: PGUSER
                  value: postgres
                - name: PGPASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: postgres-auth
                      key: postgres-password
                - name: DB_USERS
                  value: {{ join " " .Values.pgsql_users | quote }}
              command:
                - bash
                - -c
                - |
                  set -euo pipefail
                  for user in $DB_USERS; do
                    echo "==> $user"
                    # Пароль — через переменную окружения и \getenv, чтобы не попадал в аргументы процесса
                    DB_USER="$user" DB_PASSWORD="$(cat "/secrets/$user/password")" \
                      psql -v ON_ERROR_STOP=1 -d postgres <<'SQL'
                  \getenv user DB_USER
                  \getenv password DB_PASSWORD
                  SELECT format('CREATE USER %I WITH PASSWORD %L', :'user', :'password')
                    WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'user')\gexec
                  SELECT format('CREATE DATABASE %I OWNER %I', :'user', :'user')
                    WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'user')\gexec
                  SQL
                  done
              volumeMounts:
              {{- range $user := .Values.pgsql_users }}
                - name: user-{{ $user }}
                  mountPath: /secrets/{{ $user }}
                  readOnly: true
              {{- end }}
          volumes:
          {{- range $user := .Values.pgsql_users }}
            - name: user-{{ $user }}
              secret:
                secretName: postgres-user-{{ $user }}
          {{- end }}
